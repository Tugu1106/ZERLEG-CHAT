{
  "name": "zerleg",
  "version": "1.1.0",
  "private": true,
  "description": "Zerleg Chat - serverless peer-to-peer LAN chat with instant fullscreen urgent alerts",
  "author": "Zerleg Chat",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "npm run typecheck && node scripts/electron-vite.mjs build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node ../scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "fake-user": "node scripts/fake-user.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.0"
  },
  "productName": "Zerleg Chat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tugu1106/ZERLEG-CHAT.git"
  }
}
